# Build output (regenerated by build.ps1)
/build/
/dist/
/*.spec

# Virtual environment
/.venv/

# Python
__pycache__/
*.pyc
*.pyo

# Release binaries. These are large (~40 MB each) and belong on the GitHub
# Release page, not in git history - committing one per version would bloat the
# repository permanently. releases/manifest.json and releases/README.md ARE
# tracked, because they are small and describe what was shipped.
/releases/*.exe
/releases/*.zip
/releases/notes-*.md

# Generated icon preview sheet (build-time inspection only)
/assets/_*.png
